local lp = game.Players.LocalPlayer

task.spawn(function()
    while true do
        task.wait(0.1)
        local char = lp.Character
        if char and char:FindFirstChild("Humanoid") then
            local seat = char.Humanoid.SeatPart
            if seat and seat:IsA("VehicleSeat") then
                seat.MaxSpeed = 9999
                seat.Torque = 99999
                
                local vehicle = seat.Parent
                for _, descendant in ipairs(vehicle:GetDescendants()) do
                    if descendant:IsA("NumberValue") or descendant:IsA("IntAttribute") then
                        local name = descendant.Name:lower()
                        if name:find("speed") or name:find("max") then
                            pcall(function() descendant.Value = 250 end)
                        elseif name:find("torque") or name:find("horsepower") or name:find("accel") then
                            pcall(function() descendant.Value = descendant.Value * 5 end)
                        end
                    end
                end
                
                local primary = vehicle.PrimaryPart or seat
                if primary and seat.ThrottleFloat ~= 0 then
                    primary.AssemblyLinearVelocity = primary.AssemblyLinearVelocity + (primary.CFrame.LookVector * seat.ThrottleFloat * 3)
                end
            end
        end
    end
end)
